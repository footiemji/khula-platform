# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Auth ----
# Change this before deploying. Used to sign admin session tokens.
JWT_SECRET=change-this-to-a-long-random-string
# Bcrypt hash of the admin password. Generate with: npm run seed:admin
ADMIN_EMAIL=admin@khulafinancial.co.za
ADMIN_PASSWORD_HASH=

# ---- WhatsApp Business Cloud API (Meta) ----
# Get these once your WhatsApp Business Account is approved at developers.facebook.com
WHATSAPP_VERIFY_TOKEN=khula-verify-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The real, dialable WhatsApp number customers message (international format,
# no +, e.g. 27821234567) — different from WHATSAPP_PHONE_NUMBER_ID above,
# which is Meta's internal API identifier, not an actual phone number. Used
# to build the "message us first" wa.me link shown before OTP requests.
WHATSAPP_BUSINESS_NUMBER=

# ---- Third-party integrations (wire these in when credentials are issued) ----
SMILE_ID_API_KEY=
SMILE_ID_PARTNER_ID=
SIGNIFLOW_API_KEY=
NETCASH_SERVICE_KEY=
NETCASH_ACCOUNT_NUMBER=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# ---- Lending policy — matches Khula's own adopted Credit Underwriting
# Policy (04_Underwriting_Policy.docx, Section 7), not general NCA defaults.
# Adjust only with a documented policy decision, since these are the
# figures your own compliance-approved documents specify. ----
MAX_LOAN_AMOUNT=50000
MIN_LOAN_AMOUNT=500
MAX_TERM_MONTHS=60
MAX_INSTALMENT_TO_INCOME_RATIO=0.30
MIN_NET_MONTHLY_INCOME=3000
# Business days a borrower can cancel a signed loan at no cost. Confirm the
# applicable statutory right (if any) with your compliance officer.
RECONSIDERATION_DAYS=5

# ---- Cost of credit — matches Underwriting Policy Section 7. A flat 5%
# applies regardless of first-loan/repeat-loan status (your own documents
# don't draw that distinction, unlike general NCA short-term-credit
# research this MVP was originally built from — see the comment at the top
# of server/lib/costOfCredit.js for the full reasoning). ----
INTEREST_RATE_FIRST_LOAN_PCT=5
INTEREST_RATE_REPEAT_LOAN_PCT=5
INITIATION_FEE_BASE=165
INITIATION_FEE_RATE_PCT=10
INITIATION_FEE_CAP=1207.50
MONTHLY_SERVICE_FEE=69
CREDIT_LIFE_RATE_PER_1000=4.5
# Loans above this amount may fall under a different NCA bracket
# (repo-rate-linked, not implemented here) — this is a statutory question,
# not something Khula's internal policy can override, even though that
# policy doesn't address it. Quotes above this are flagged for compliance
# review rather than silently computed at the flat rate above.
SHORT_TERM_CREDIT_CEILING=8000

# ---- Deployment ----
# Public URL of this app once deployed, used in WhatsApp message links.
PUBLIC_APP_URL=http://localhost:3000

# ---- Database ----
# Leave unset to use the zero-setup local JSON file store (server/data/*.json).
# Set this to a Postgres connection string to persist data properly — see
# docs/DATABASE.md. Example: postgres://user:password@host:5432/dbname
DATABASE_URL=

# ---- KYC document encryption ----
# Required before document uploads will work. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back this up like any other production secret — losing it means losing
# access to every stored document.
KYC_ENCRYPTION_KEY=

# ---- Collections reminders ----
# How many days before an instalment is due to send a WhatsApp reminder.
REMINDER_DAYS_BEFORE=3
# How often the background sweep checks for due/overdue instalments (ms).
# Default 6 hours. See server/lib/collectionsSweep.js for production notes
# on running more than one instance of this app.
COLLECTIONS_SWEEP_INTERVAL_MS=21600000
